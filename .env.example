# Server-side keys (never exposed to the browser). All optional.

# Alchemy: faster Ethereum/Base/Robinhood RPC + NFT support
ALCHEMY_API_KEY=

# Xverse (Secret Key Labs) key for full Ordinals metadata; without it a keyless
# Xverse endpoint is used (inscription ids + content types only)
XVERSE_API_KEY=

# Unisat developer key for BRC-20 balances (free at developer.unisat.io)
UNISAT_API_KEY=

# Dedicated Solana RPC (e.g. Helius/QuickNode); the public endpoint is rate-limited
SOLANA_RPC_URL=

# Upstash Redis for encrypted sync codes (Vercel's Upstash integration sets these;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work). Without them,
# development keeps synced copies in memory and production turns sync off.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# CoinGecko Demo key for native coin prices (DexScreener/GeckoTerminal need no key)
COINGECKO_API_KEY=

# Optional: wallets offered as "Load test wallets" on an empty dashboard
NEXT_PUBLIC_TEST_ETH_WALLET=
NEXT_PUBLIC_TEST_BTC_WALLET=
