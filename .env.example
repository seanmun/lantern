# Server-side keys (never exposed to the browser). All optional.

# Alchemy: faster Ethereum/Base/Robinhood RPC + NFT support
ALCHEMY_API_KEY=

# Xverse (Secret Key Labs) key for full Ordinals metadata; without it a keyless
# Xverse endpoint is used (inscription ids + content types only)
XVERSE_API_KEY=

# CoinGecko Demo key for native coin prices (DexScreener/GeckoTerminal need no key)
COINGECKO_API_KEY=

# Optional: wallets offered as "Load test wallets" on an empty dashboard
NEXT_PUBLIC_TEST_ETH_WALLET=
NEXT_PUBLIC_TEST_BTC_WALLET=
